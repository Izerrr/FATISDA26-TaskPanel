generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Prodi {
  INFORMATIKA
  SAINS_DATA
}

enum Kelas {
  A
  B
  C
  D
  E
}

enum Role {
  STUDENT
  PJ_KELAS
  PJ_MATKUL
  ADMIN
}

enum TaskScope {
  PERSONAL
  CLASS
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  NEED_REVIEW
  DONE
}

model User {
  id            String      @id // Discord User ID
  username      String
  avatar        String?
  prodi         Prodi?
  kelas         Kelas?
  roles         Role[]      @default([STUDENT])
  discordRoles  String[]    
  createdTasks  Task[]      @relation("CreatedTasks")
  assignedTasks Task[]      @relation("AssignedTasks")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model Course {
  id          String    @id @default(cuid())
  code        String    // Contoh: "IF26-101"
  name        String    // Contoh: "Struktur Data"
  prodi       Prodi
  kelas       Kelas?    
  pjMatkulId  String?
  tasks       Task[]
  createdAt   DateTime  @default(now())
}

model Task {
  id          String     @id @default(cuid())
  title       String
  description String?
  status      TaskStatus @default(TODO)
  scope       TaskScope  @default(PERSONAL)
  prodi       Prodi?
  kelas       Kelas?
  courseId    String?
  course      Course?    @relation(fields: [courseId], references: [id])
  createdById String
  createdBy   User       @relation("CreatedTasks", fields: [createdById], references: [id])
  assignedTo  String?
  assignee    User?      @relation("AssignedTasks", fields: [assignedTo], references: [id])
  dueDate     DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model ScheduleSync {
  id            String   @id @default(cuid())
  spreadsheetId String
  sheetName     String
  lastSyncedAt  DateTime @default(now())
}