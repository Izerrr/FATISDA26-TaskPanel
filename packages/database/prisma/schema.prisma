generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Prodi {
  INFORMATIKA
  SAINS_DATA
  INFORMATIKA_PSDKU_KEBUMEN
}

enum Kelas {
  A
  B
  C
  D
  E
}

enum Role {
  STUDENT
  PJ_MATKUL
  PJ_KELAS
  KETUA_ANGKATAN
  ADMIN
  OWNER
}

enum TaskScope {
  PERSONAL
  CLASS
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  NEED_REVIEW
  DONE
}

model Guild {
  id        String   @id
  name      String
  icon      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks Task[]
}

model User {
  id       String  @id
  username String
  avatar   String?

  prodi    Prodi?
  kelas    Kelas?
  semester Int?

  roles        Role[]   @default([STUDENT])
  discordRoles String[] @default([])

  createdTasks  Task[] @relation("CreatedTasks")
  assignedTasks Task[] @relation("AssignedTasks")

  updatedVaults CourseVault[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Schedule {
  id       String @id @default(cuid())

  prodi    Prodi
  kelas    Kelas
  semester Int?

  courseId String?
  course   Course? @relation(fields: [courseId], references: [id])

  courseName String

  day       Int
  startTime String
  endTime   String
  room      String?
  lecturer  String?

  rawClassCode String?
  markers      String[] @default([])
  sourceSlots  Int[]    @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([prodi, kelas, semester])
  @@index([courseId])
}

model Course {
  id         String  @id @default(cuid())
  code       String
  name       String
  prodi      Prodi
  kelas      Kelas?
  pjMatkulId String?

  tasks     Task[]
  schedules Schedule[]
  vaults    CourseVault[]

  createdAt DateTime @default(now())

  @@unique([code, prodi, kelas])
  @@index([prodi, kelas])
}

model CourseVault {
  id          String   @id @default(cuid())
  courseId    String?
  courseName  String
  prodi       Prodi
  kelas       Kelas?
  semester    Int?

  driveUrl     String?
  modulUrl     String?
  silabusUrl   String?
  communityUrl String?
  notes        String?

  extraLinks   Json?    @default("[]")

  updatedById String?
  updatedBy   User?    @relation(fields: [updatedById], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  course      Course?  @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseName, prodi, kelas])
  @@index([prodi, kelas])
  @@index([courseId])
}

model Task {
  id          String     @id @default(cuid())
  guildId     String
  title       String
  description String?
  status      TaskStatus @default(TODO)
  scope       TaskScope  @default(PERSONAL)

  prodi Prodi?
  kelas Kelas?

  courseId String?
  course   Course? @relation(fields: [courseId], references: [id])

  createdById String
  createdBy   User @relation("CreatedTasks", fields: [createdById], references: [id])

  assignedTo String?
  assignee   User? @relation("AssignedTasks", fields: [assignedTo], references: [id])

  dueDate DateTime?

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([guildId])
  @@index([createdById])
  @@index([assignedTo])
  @@index([courseId])
  @@index([status])
  @@index([scope])
}

model ScheduleSync {
  id String @id @default(cuid())

  prodi Prodi

  spreadsheetId String
  sheetGid      String
  sheetName     String

  rawEntries        Int @default(0)
  normalizedEntries Int @default(0)

  lastSyncedAt DateTime @default(now())

  @@unique([prodi, spreadsheetId, sheetGid])
  @@index([prodi])
}