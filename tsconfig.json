{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./apps/dashboard/src/*"]
    }
  },
  "include": ["apps/dashboard/next-env.d.ts", "apps/dashboard/src/**/*", "apps/dashboard/.next/types/**/*.ts", "apps/bot/src/**/*"],
  "exclude": ["node_modules", "**/node_modules", "**/.next"]
}
